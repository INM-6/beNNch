#SBATCH --partition=#PARTITION#
#SBATCH --job-name=benchmark
#SBATCH -o stdout
#SBATCH -e stderr
#SBATCH --nodes=#NODES#
#SBATCH --ntasks-per-node=#NTASKS_PER_NODE#
#SBATCH --cpus-per-task=#THREADS_PER_TASK#
#SBATCH --time=#TIME#
#SBATCH --exclusive
#SBATCH --account=#ACCOUNT#
#SBATCH --hint=nomultithread
#SBATCH --distribution=block:block:fcyclic
#SBATCH #EXTRA_SBATCH_FLAGS#

module load $MODULE_LIST
python -m venv --system-site-packages -p python3.8 compute-env
source compute-env/bin/activate
compute-env/bin/pip install --no-index --find-links=${CI_PROJECT_DIR}/pip_packages ${CI_PROJECT_DIR}/pip_packages/*
export PATH="$(pwd):$PATH"

echo "JobId: $SLURM_JOB_ID"

set -exo pipefail

export OMP_NUM_THREADS=#THREADS_PER_TASK#
export OMP_PROC_BIND=TRUE

export OMP_DISPLAY_ENV=VERBOSE
export OMP_DISPLAY_AFFINITY=TRUE

# Avoid problems from numexpr Python package
export NUMEXPR_MAX_THREADS=$OMP_NUM_THREADS

module use #MODULES_DIR#
module load simulator/#BRANCH#/default
source #PREPARE_FILE#

if ! source jemalloc.sh; then
  echo "Sourcing jemalloc failed, continue without it"
fi

module list

#COMMANDS#

scontrol show jobid ${SLURM_JOB_ID} -dd

touch ready
