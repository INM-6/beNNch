#SBATCH --partition=#PARTITION#
#SBATCH --job-name=benchmark
#SBATCH -o stdout
#SBATCH -e stderr
#SBATCH --nodes=#NODES#
#SBATCH --ntasks-per-node=#NTASKS_PER_NODE#
#SBATCH --cpus-per-task=#THREADS_PER_TASK#
#SBATCH --time=#TIME#
#SBATCH --exclusive
#SBATCH --account=#ACCOUNT#
#SBATCH --hint=nomultithread
#SBATCH --distribution=block:block:fcyclic
#SBATCH #EXTRA_SBATCH_FLAGS#

echo "JobId: $SLURM_JOB_ID"
echo "CurrentDirectory: $(pwd)"
ls -l
set -exo pipefail

export CPU_BIND_MASK="$(python3 "$CI_PROJECT_DIR/.gitlab-ci/scripts/pinning_mask.py" #NTASKS_PER_NODE# #THREADS_PER_TASK#)"

export OMP_NUM_THREADS=#THREADS_PER_TASK#
export OMP_PROC_BIND=spread
export OMP_PLACES=threads

export OMP_DISPLAY_ENV=VERBOSE
export OMP_DISPLAY_AFFINITY=TRUE

export KMP_AFFINITY=verbose,balanced


# Avoid problems from numexpr Python package
export NUMEXPR_MAX_THREADS=$OMP_NUM_THREADS

if ! source jemalloc.sh; then
  echo "Sourcing jemalloc failed, continue without it"
fi


#activate the venv that already contains gathermetadata
source "$CI_PROJECT_DIR/benchmarking-env/bin/activate"



module list

gathermetadata metadata-before

#COMMANDS#

gathermetadata metadata

touch ready
